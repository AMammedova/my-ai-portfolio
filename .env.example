# Set to "true" to use the live LLM for visitor chat (portfolio-data as context).
NEXT_PUBLIC_PORTFOLIO_AI=true

# --- LLM (OpenAI-compatible Chat Completions + SSE) — all server-only, never NEXT_PUBLIC_* ---

# API key (pick one name; PORTFOLIO_LLM_API_KEY wins if both are set)
PORTFOLIO_LLM_API_KEY=
# OPENAI_API_KEY=

# Base URL without trailing slash (default: OpenAI)
# PORTFOLIO_LLM_BASE_URL=https://api.openai.com/v1

# Model id (provider-specific)
# PORTFOLIO_LLM_MODEL=gpt-4o-mini

# --- Examples (use your own keys) ---
#
# DeepSeek (https://api-docs.deepseek.com/)
# PORTFOLIO_LLM_BASE_URL=https://api.deepseek.com/v1
# PORTFOLIO_LLM_MODEL=deepseek-chat
# PORTFOLIO_LLM_API_KEY=sk-...
#
# Groq (https://console.groq.com/)
# PORTFOLIO_LLM_BASE_URL=https://api.groq.com/openai/v1
# PORTFOLIO_LLM_MODEL=llama-3.3-70b-versatile
# PORTFOLIO_LLM_API_KEY=gsk_...
#
# OpenRouter (https://openrouter.ai/docs) — optional headers for rankings
# PORTFOLIO_LLM_BASE_URL=https://openrouter.ai/api/v1
# PORTFOLIO_LLM_MODEL=openai/gpt-4o-mini
# PORTFOLIO_LLM_API_KEY=sk-or-...
# PORTFOLIO_LLM_HTTP_REFERER=https://yoursite.example
# PORTFOLIO_LLM_HTTP_TITLE=My portfolio
